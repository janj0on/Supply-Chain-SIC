    {
      "id": 10,
      "type": "table",
      "title": "Top 10 vehicles - alerts by type (last $window)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 11,
        "w": 16,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (vehicle_id, anomaly_type) (round(increase(supply_alerts_by_vehicle_total[$window]))) > 0 and on (vehicle_id) topk(10, sum by (vehicle_id) (round(increase(supply_alerts_by_vehicle_total[$window]))) > 0)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "anomaly_type",
            "rowField": "vehicle_id",
            "valueField": "Value"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "fields": {},
            "conversions": [
              {
                "targetField": "temperature_breach",
                "destinationType": "number"
              },
              {
                "targetField": "excessive_idling",
                "destinationType": "number"
              },
              {
                "targetField": "route_deviation",
                "destinationType": "number"
              },
              {
                "targetField": "overspeed",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "reducer": "sum"
            },
            "alias": "Total"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Total",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "vehicle_id\\anomaly_type": "Vehicle"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
