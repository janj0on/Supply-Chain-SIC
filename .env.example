# ---------- Kafka (scripts run on your laptop, so they use the EXTERNAL listener) ----------
BOOTSTRAP=localhost:9092
CLIENT_ID_FILE=supply-chain-file-producer
CLIENT_ID_DISPATCHER=supply-chain-dispatcher
DLQ_TOPIC=producer-dlq
TOPIC_PARTITIONS=3
REPLICATION_FACTOR=1
CSV_REFRESH_SECONDS=2
TELEMETRY_POLL_SECONDS=0.2

# ---------- World ----------
START_WAREHOUSE_ID=WH-11
# trucks are TRUCK-1 ... TRUCK-30. The lowest FREE number is always used first,
# so you only ever see as many numbers as there are cars on the road at that moment.
FLEET_SIZE=30
SEND_INTERVAL_SECONDS=5
TRIP_DURATION_SECONDS=200
SIMULATION_SPEED=1.0
# seconds until a truck that arrived can be used again
TURNAROUND_SECONDS=2
RANDOM_SEED=42

# ---------- Demand (1.0 = about one order every 4 s, ~58 cars on the road. 0.2 = about 12 cars. Lower = fewer cars) ----------
DEMAND_SCALE=0.2

# ---------- Anomalies (episodes that last several readings) ----------
ENABLE_ANOMALIES=true
# chance per reading that a new anomaly starts (0.01 = about one per 2-3 trips)
ANOMALY_PROBABILITY=0.01
# chance per reading of a short harmless blip the detector must ignore
BLIP_PROBABILITY=0.01
ENABLE_TEMPERATURE_BREACH=true
ENABLE_IDLING=true
# ENABLE_GPS_JUMP is still read as a fallback name for this one
ENABLE_ROUTE_DEVIATION=true
ENABLE_OVERSPEED=true

# ---------- Messy data (schema is never changed) ----------
ENABLE_MESSY_DATA=true
JITTER_SECONDS=0.3
DUPLICATE_PROBABILITY=0.02
LATE_PROBABILITY=0.03
LATE_WITHIN_WATERMARK_RATIO=0.7
MAX_LATE_SECONDS=45
OFFLINE_PROBABILITY=0.004
OFFLINE_DROP_RATIO=0.3
